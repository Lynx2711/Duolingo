# =============================================
# .gitignore — Duolingo Clone Monorepo
# =============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Environment variables ---
.env
.env*.local
.env.local
!.env.example

# --- Database (auto-seeded on startup) ---
*.db
*.sqlite3

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Alembic compiled ---
backend/alembic/versions/__pycache__/

# --- Misc / Non-project files ---
*.log
assignment.txt
solve.py
backend/test_*.py
