# The connection string for the database.
# For local SQLite development, use sqlite:///./duolingo.db
# For production PostgreSQL, use postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./duolingo.db

# A JSON-formatted array of allowed origins for Cross-Origin Resource Sharing (CORS).
# When running the frontend locally on port 3000, keep this as ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]
